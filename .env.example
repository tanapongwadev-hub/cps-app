# Copy this file to .env.local and adjust values for your machine.
# .env.local is gitignored — never commit real backend URLs or secrets.

# =============================================================================
# App Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME=Admin Template
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# =============================================================================
# API Configuration
# =============================================================================
# Base URL สำหรับ API จริง (NestJS Backend)
# ตัวอย่าง: http://localhost:3001/api/v1
NEXT_PUBLIC_API_BASE_URL=/api

# Timeout สำหรับ API request (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# เปิด/ปิด Mock API
# - true  = ใช้ in-memory mock handlers (default สำหรับ development)
# - false = เรียก API จริง
NEXT_PUBLIC_ENABLE_MOCK_API=true

# =============================================================================
# Features
# =============================================================================
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_I18N=true
